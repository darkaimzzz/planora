{
  "expo": {
    "name": "Planora",
    "slug": "planora",
    "scheme": "planora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.darkaimzzz.planora",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:planorafun.vercel.app"
      ]
    },
    "android": {
      "package": "com.darkaimzzz.planora",
      "adaptiveIcon": {
        "backgroundColor": "#FE5E4D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "planorafun.vercel.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FE5E4D"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa11900c-5842-410f-afab-2ccd70ee1d89"
      }
    },
    "owner": "darkaimxd"
  }
}
