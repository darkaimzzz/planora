{
  "name": "planora",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8085",
    "dev:web": "expo start --web --port 8085",
    "dev:clear": "expo start --port 8085 --clear",
    "android": "expo start --android --port 8085",
    "ios": "expo start --ios --port 8085",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "deploy:function": "node scripts/deploy-function.mjs",
    "audit": "node scripts/audit.mjs",
    "build:apk": "eas build --platform android --profile apk",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tamagui/animations-moti": "^2.7.7",
    "@tamagui/babel-plugin": "^2.7.7",
    "@tamagui/config": "^2.7.7",
    "@tamagui/core": "^2.7.7",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
